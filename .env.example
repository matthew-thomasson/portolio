# ============================================================================
# Substack Downloader & Multi-Source Portfolio Backtester Configuration
# ============================================================================
# Copy this file to .env and fill in your session cookies:
#
# How to get your Substack session cookie:
# 1. Open the publication URL in Chrome/Edge while logged into your paid account.
# 2. Press F12 -> "Application" tab -> "Cookies".
# 3. Look for "connect.sid" (used on custom domains) or "substack.sid".
# 4. Copy the raw Cookie Value and paste it below.
# ============================================================================

# 1. Beating The Tide (https://www.beatingthetide.com)
BEATINGTHETIDE_URL=https://www.beatingthetide.com/
BEATINGTHETIDE_COOKIE_NAME=connect.sid
BEATINGTHETIDE_COOKIE_VAL=

# 2. Cluseau (https://www.cluseau.com)
CLUSEAU_URL=https://www.cluseau.com/
CLUSEAU_COOKIE_NAME=connect.sid
CLUSEAU_COOKIE_VAL=

# 3. TJ Stocks (https://tjstocks.substack.com)
TJSTOCKS_URL=https://tjstocks.substack.com/
TJSTOCKS_COOKIE_NAME=substack.sid
TJSTOCKS_COOKIE_VAL=

# Default Simulation Parameters
ALLOCATION_MODE=fixed_unit
DEFAULT_UNIT_USD=1000.0
ADD_UNIT_USD=500.0
TRIM_FRACTION=0.333333
BENCHMARK_TICKER=SPY
REINVEST_SALES_CASH=true
