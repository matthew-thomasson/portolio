2r!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 424w, https://substackcdn.com/image/fetch/$s_!dW2r!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 848w, https://substackcdn.com/image/fetch/$s_!dW2r!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 1272w, https://substackcdn.com/image/fetch/$s_!dW2r!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 1456w\" sizes=\"100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!dW2r!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png\" width=\"702\" height=\"49\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/cba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:49,&quot;width&quot;:702,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:5631,&quot;alt&quot;:&quot;Interactive Brokers ticket selling AXIA Energia (Eletrobras) ADR at $9.71 via an Adaptive Limit order in the Beating The Tide portfolio.&quot;,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://www.beatingthetide.com/i/201149646?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"Interactive Brokers ticket selling AXIA Energia (Eletrobras) ADR at $9.71 via an Adaptive Limit order in the Beating The Tide portfolio.\" title=\"Interactive Brokers ticket selling AXIA Energia (Eletrobras) ADR at $9.71 via an Adaptive Limit order in the Beating The Tide portfolio.\" srcset=\"https://substackcdn.com/image/fetch/$s_!dW2r!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 424w, https://substackcdn.com/image/fetch/$s_!dW2r!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 848w, https://substackcdn.com/image/fetch/$s_!dW2r!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 1272w, https://substackcdn.com/image/fetch/$s_!dW2r!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcba151b9-40df-4bb7-9c6c-b0c99fb3a442_702x49.png 1456w\" sizes=\"100vw\"></picture><div></div></div></div></figure></div><p>The reason is simple. In April the board <a href=\"https://www.tipranks.com/news/company-announcements/axia-energia-moves-to-delist-nyse-adrs-and-shift-to-brazils-novo-mercado\">approved delisting the ADRs</a> to concentrate trading in a single listing, the ordinary shares on Brazil's B3 exchange in São Paulo. Management's logic is that the ADRs make up just 2.5% of the shareholder base, so pulling them consolidates liquidity at home and lines up with the company's move to the Novo Mercado governance segment.</p><p>It's a disappointing way to exit. I picked AXIA in January…</p><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;dd802a86-c61f-4ee3-9f29-106f67787c85&quot;,&quot;caption&quot;:&quot;On January 8, I sent a trade alert to paid subscribers adding a Latam utility to the portfolio.&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;A Boring LATAM Utility With a Not-So-Boring +40% Upside&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:84964221,&quot;name&quot;:&quot;George Atuan, CFA&quot;,&quot;bio&quot;:&quot;Engineer, MBA, CFA and portfolio manager. Sharing insights from 14 years of beating the market, blending deep analysis with real-world experience. Subscribe for actionable investment ideas and strategies.&quot;,&quot;photo_url&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/e772d065-0c6f-4078-a88c-106ff8783751_830x830.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:100}],&quot;post_date&quot;:&quot;2026-01-21T17:48:41.408Z&quot;,&quot;cover_image&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/cb652a7a-ae76-4b10-a5d9-7c7de73a3ab7_1920x1080.png&quot;,&quot;cover_image_alt&quot;:null,&quot;cover_image_crop&quot;:null,&quot;canonical_url&quot;:&quot;https://www.beatingthetide.com/p/the-stock-that-slipped-through-my-fingers&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:183941918,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:6,&quot;comment_count&quot;:0,&quot;publication_id&quot;:3704888,&quot;publication_name&quot;:&quot;Beating The Tide: Stock Picks That Outperform&quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!gAPf!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F6d3ba013-697a-4c40-8852-b0e744ef69c5_351x351.png&quot;,&quot;belowTheFold&quot;:false,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><p>… and the shares hit my target within three months.</p><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;0b45cc39-9452-4e24-9616-807f7c9b1482&quot;,&quot;caption&quot;:&quot;Back in January, I published a deep dive on a Latin American utility offering 40% upside.&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;This Latam Utility Hit My Target (+40%) in 3 Months. Now What?&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:84964221,&quot;name&quot;:&quot;George Atuan, CFA&quot;,&quot;bio&quot;:&quot;Engineer, MBA, CFA and portfolio manager. Sharing insights from 14 years of beating the market, blending deep analysis with real-world experience. Subscribe for actionable investment ideas and strategies.&quot;,&quot;photo_url&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/e772d065-0c6f-4078-a88c-106ff8783751_830x830.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:100}],&quot;post_date&quot;:&quot;2026-04-20T17:26:11.654Z&quot;,&quot;cover_image&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/536b66c0-106f-420d-a192-7d854214ecfd_1920x1080.png&quot;,&quot;cover_image_alt&quot;:null,&quot;cover_image_crop&quot;:null,&quot;canonical_url&quot;:&quot;https://www.beatingthetide.com/p/this-latam-utility-company-update-q4-fy2025&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:194453620,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:7,&quot;comment_count&quot;:0,&quot;publication_id&quot;:3704888,&quot;publication_name&quot;:&quot;Beating The Tide: Stock Picks That Outperform&quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!gAPf!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F6d3ba013-697a-4c40-8852-b0e744ef69c5_351x351.png&quot;,&quot;belowTheFold&quot;:false,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><p>Holders with Interactive Brokers or a Brazilian broker can ask for the ADRs to be cancelled and take delivery of the ordinary shares instead. I looked at it, but most of my subscribers can't trade on the Brazilian exchange, so I'm closing the position in the model portfolio to keep the tracking clean.</p><p></p><p></p><p></p>",
